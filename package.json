{
  "name": "tennis-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:frontend": "bash scripts/deploy_frontend.sh",
    "db:migrate:local": "wrangler d1 migrations apply tennis_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tennis_db --remote",
    "db:export": "mkdir -p backups && wrangler d1 export tennis_db --remote --output backups/tennis_db_$(date +%Y%m%d_%H%M%S).sql"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/node": "^22.10.2",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "wrangler": "4.129.0"
  }
}
